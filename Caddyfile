{
	admin off
}

:{$PORT:8080} {
	redir /rust2lctrs/demo /rust2lctrs/demo/ 308

	# API calls go to the rust2lctrs server over Railway's private network.
	handle /rust2lctrs/demo/v1/* {
		uri strip_prefix /rust2lctrs/demo
		reverse_proxy {$API_UPSTREAM}
	}

	handle_path /rust2lctrs/demo/* {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	handle {
		respond 404
	}
}
